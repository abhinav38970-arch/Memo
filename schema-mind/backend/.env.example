# ── Groq ──────────────────────────────────────────────────────────────────
# API key (get yours at https://console.groq.com/keys)
GROQ_API_KEY=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

# Model (default: openai/gpt-oss-120b — the free tier gives it 8,000 tokens/min)
# GROQ_MODEL=openai/gpt-oss-120b

# Tokens-per-minute limit to assume before the real one is learned from Groq's
# response headers. Free tier = 8000. On the Developer plan this is much higher
# (see https://console.groq.com/settings/limits) — set it so long texts get the
# full completion budget on the very first request.
# GROQ_TPM_LIMIT=8000

# Hard cap on completion tokens per request (default 4096). The client sizes
# each request below this automatically so prompt + completion fits the TPM
# window; you normally don't need to touch it.
# GROQ_MAX_TOKENS=4096

# Reasoning effort for gpt-oss models: low | medium | high, or "off" to send no
# reasoning parameters at all. Reasoning tokens count toward the TPM budget, so
# "low" is the default.
# GROQ_REASONING_EFFORT=low

# Longest a single API request will wait for the TPM window to reset before
# returning 429 to the client (default 40s). Render's proxy times out at ~100s.
# GROQ_MAX_WAIT_SECONDS=40
